# Copy this file to ".env" (same folder) and fill in your own keys.

# ---- Razorpay payment gateway (supports UPI, cards, netbanking, wallets) ----
# 1. Sign up at https://dashboard.razorpay.com/signup
# 2. Go to Settings > API Keys > Generate Test Key (or Live Key once approved)
# 3. Paste them below
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ---- Delivery partner payout ----
RATE_PER_KM=8
MIN_DELIVERY_FEE=20
DEFAULT_DISTANCE_KM=3
